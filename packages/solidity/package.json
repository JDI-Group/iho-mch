{
  "name": "@hardhat/client",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "description": "hardhat3-alpha empty project",
  "license": "ISC",
  "main": "dist/index.ts",
  "scripts": {
    "test": "hardhat test ",
    "deploy:geneva:iho-market": "lnv -o --vlt -- hardhat --build-profile production ignition deploy ignition/modules/IHOMarket.ts --network moonchainGeneva",
    "deploy:geneva:iho-mining": "lnv -o --vlt -- hardhat --build-profile production ignition deploy ignition/modules/IHOMining.ts --network moonchainGeneva",
    "script:mining": "lnv -o --vlt -- hardhat run ./scripts/mining.ts --build-profile production",
    "postinstall": "pnpm etherlib generate"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/contracts-upgradeable": "^5.3.0",
    "solady": "^0.1.18"
  },
  "devDependencies": {
    "@hairy/utils": "^1.29.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0-next.13",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.0-next.13",
    "@nomicfoundation/hardhat-toolbox-viem": "4.0.0-next.13",
    "@nomicfoundation/hardhat-viem": "3.0.0-next.13",
    "@types/node": "^22.15.18",
    "eslint": "^9.26.0",
    "etherlib-generator": "^0.0.9",
    "ethers": "^6.14.3",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "3.0.0-next.13",
    "nanoid": "^5.1.5",
    "typescript": "~5.5.4",
    "viem": "^2.29.2",
    "wagmi": "^2.15.3"
  }
}
