#/----------------settings/metadata-----------------/
DOTENV_VAULT="vlt_8c3e168ecdb2bd6fbae0ff1dc845d9cd981bf02f82cd7918a612cf6d5b67c20c"
DOTENV_API_URL="https://vault.dotenv.org"
