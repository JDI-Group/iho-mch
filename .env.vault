# development
DOTENV_VAULT_DEVELOPMENT=""
DOTENV_VAULT_DEVELOPMENT_VERSION=21

# testnet
DOTENV_VAULT_TESTNET=""
DOTENV_VAULT_TESTNET_VERSION=22

# mainnet
DOTENV_VAULT_MAINNET=""
DOTENV_VAULT_MAINNET_VERSION=27

#/----------------settings/metadata-----------------/
DOTENV_VAULT="vlt_dc436015b6e9fe371fef76acda1564cc504a851fdc28961327bf7bd70cc2d566"
DOTENV_API_URL="https://vault.dotenv.org"
DOTENV_CLI="npx dotenv-vault@latest"
