{
  "name": "@harsta/client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./wagmi": {
      "types": "./dist/wagmi/index.d.ts",
      "import": "./dist/wagmi/index.mjs",
      "require": "./dist/wagmi/index.js"
    },
    "./chains": {
      "types": "./dist/chains/index.d.ts",
      "import": "./dist/chains/index.mjs",
      "require": "./dist/chains/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.mjs",
      "require": "./dist/contracts/index.js"
    },
    "./factories": {
      "types": "./dist/factories/index.d.ts",
      "import": "./dist/factories/index.mjs",
      "require": "./dist/factories/index.js"
    },
    "./typechain/*": "./dist/typechains/contracts/*",
    "./typechain": {
      "types": "./dist/typechains/contracts/index.d.ts",
      "import": "./dist/typechains/contracts/index.mjs",
      "require": "./dist/typechains/contracts/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "deploy:hardhat": "lnv -o --vlt -- harsta deploy --verify --network hardhat",
    "deploy:testnet": "lnv -o --vlt -- harsta deploy --verify --network moonchain_geneva",
    "deploy:mainnet": "lnv -o --vlt -- harsta deploy --verify --network moonchain",
    "verify:testnet": "lnv -o --vlt -- harsta verify --network moonchain_geneva --target",
    "verify:mainnet": "lnv -o --vlt -- harsta verify --network moonchain --target",
    "test:hardhat": "lnv -o --vlt -- harsta test --network hardhat",
    "test:fork:testnet": "lnv -o --vlt -- harsta test --network hardhat --fork moonchain_geneva",
    "test:fork:mainnet": "lnv -o --vlt -- harsta test --network hardhat --fork moonchain",
    "build": "harsta compile --clean --output dist",
    "postinstall": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "viem": "2.x",
    "wagmi": "2.x"
  },
  "dependencies": {
    "ethers": "^6.13.5",
    "wagmi": "^2.15.2"
  },
  "devDependencies": {
    "harsta": "^0.10.6",
    "vitest": "^3.1.3"
  }
}
