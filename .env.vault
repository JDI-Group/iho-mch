# development
DOTENV_VAULT_DEVELOPMENT=""
DOTENV_VAULT_DEVELOPMENT_VERSION=3

# testnet
DOTENV_VAULT_TESTNET=""
DOTENV_VAULT_TESTNET_VERSION=4

# mainnet
DOTENV_VAULT_MAINNET=""
